# ==============================================================================
# gptokeyb profile for RomM & SMB Client (R36S / ArkOS)
# Maps R36S physical handheld buttons to RomM keyboard navigation
# ==============================================================================

back = esc
start = enter
a = enter
b = backspace
x = x
y = y
l1 = pageup
l2 = q
r1 = pagedown
r2 = m

up = up
down = down
left = left
right = right

left_analog_up = up
left_analog_down = down
left_analog_left = left
left_analog_right = right

right_analog_up = \"
right_analog_down = \"
right_analog_left = \"
right_analog_right = \"

deadzone_mode = scaled_radial
deadzone = 2000
deadzone_scale = 8
deadzone_delay = 16
mouse_scale = 512
mouse_delay = 16
